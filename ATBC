<script>
  // Anniversary countdown. October is Central Daylight Time (UTC-5).
  (function () {
    var el = document.getElementById("countdown");
    if (!el) return;
    var target = new Date("2026-10-17T00:00:00-05:00");
    var days = Math.ceil((target - new Date()) / 86400000);
    if (days > 1) el.textContent = days + " days to go";
    else if (days === 1) el.textContent = "Tomorrow";
    else if (days === 0) el.textContent = "Today";
